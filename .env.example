# Cold Email AI Skills — Environment Variables
#
# Copy this file to .env and fill in the API keys for the skills you'll use.
# You do NOT need all of these — only the ones the skills you invoke depend on.
#
# Minimum for your first campaign: SMARTLEAD + PROSPEO + DYNADOT + ZAPMAIL

# ============================================================
# ORCHESTRATION — Trigger.dev (background jobs / scheduling)
# ============================================================

# Trigger.dev dev secret key. Sign up: https://trigger.dev/
# Find key: dashboard → your project → API keys → DEV key (starts with tr_dev_).
# Used by `npx trigger.dev@latest dev` and by the SDK to talk to your project.
TRIGGER_SECRET_KEY=

# Optional: your Trigger.dev project reference (looks like proj_abc123).
# trigger.config.ts reads this if set; otherwise put the ref directly in that file.
TRIGGER_PROJECT_REF=

# ============================================================
# DATABASE — Supabase (source of truth for the GTM research engine)
# ============================================================
# Dashboard → Project Settings → API keys. Uses the CURRENT API-key model.

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Secret key (sb_secret_…) — SERVER-SIDE ONLY, bypasses RLS. Used by Trigger.dev
# tasks + the internal API. Never expose to any frontend.
SUPABASE_SECRET_KEY=

# Publishable key (sb_publishable_…) — RLS-enforced, safe for public/read clients.
SUPABASE_PUBLISHABLE_KEY=

# Optional: JWKS endpoint for verifying Supabase-issued JWTs (asymmetric keys).
SUPABASE_JWKS_URL=

# ============================================================
# AI — qualification / research (Claude default, OpenAI fallback)
# ============================================================
# Anthropic. https://console.anthropic.com/  (default AIProvider)
ANTHROPIC_API_KEY=

# ============================================================
# CORE — always needed
# ============================================================

# Smartlead (sending platform). Sign up: https://smartlead.ai/
# Find key: dashboard → Settings → API. Copy the key.
SMARTLEAD_API_KEY=

# Prospeo (list building). Sign up: https://prospeo.io/
# Find key: dashboard → API. Copy the X-KEY.
PROSPEO_API_KEY=

# ============================================================
# INFRASTRUCTURE — for buying domains + creating inboxes
# ============================================================

# Dynadot (domain registrar). Sign up: https://www.dynadot.com/
# Find key: Account → Tools → API → API Key (request bulk API access if not enabled)
DYNADOT_API_KEY=

# Zapmail (inbox provider). Sign up: https://zapmail.ai/
# Find key: Account → API → Generate token.
ZAPMAIL_API_KEY=

# ============================================================
# EMAIL VALIDATION
# ============================================================

# MillionVerifier (email validation). Sign up: https://www.millionverifier.com/
# Find key: Dashboard → API Key. Needed for auto-research and waterfall.
MILLIONVERIFIER_API_KEY=

# ============================================================
# OPTIONAL — list building alternatives
# ============================================================

# Blitz (domain-to-contacts). Sign up: https://www.useblitz.com/
BLITZ_API_KEY=
BLITZ_BASE_URL=https://api.useblitz.com

# RapidAPI (Google Maps scraping + LinkedIn). Sign up: https://rapidapi.com/
# Then subscribe to:
#   - Maps Data API: https://rapidapi.com/alexanderxbx/api/maps-data
#   - LinkedIn Bulk Data: https://rapidapi.com/apibuilderz/api/realtime-linkedin-bulk-data
RAPIDAPI_KEY=

# ============================================================
# AI QUALIFICATION — scoring companies against an ICP at scale
# ============================================================

# OpenAI (list-expander's score-batch.ts + verify-website.ts).
# Sign up: https://platform.openai.com/api-keys
# Default model is gpt-5-nano — cheap enough to score a whole TAM.
OPENAI_API_KEY=

# Optional: a separate key for the cheap qualification model. Used in
# preference to OPENAI_API_KEY when set.
OPENAI_API_KEY_NANO=

# Optional: override the qualification model (default: gpt-5-nano)
OPENAI_ICP_MODEL=

# ============================================================
# OPTIONAL — extra lookalike sources (list-expander Phase 2)
# ============================================================
# Each is one lane. If a key is missing, that lane is skipped with a log line
# and the run still completes on Prospeo alone.

# Exa (website-content similarity — findSimilar). Sign up: https://exa.ai/
EXA_API_KEY=

# Parallel.ai (NL entity search). Sign up: https://parallel.ai/
# Pads results to match_limit with junk — always AI-qualify before trusting.
PARALLEL_AI_API_KEY=

# Optional: slow down Prospeo pacing. The built-in floor is 450ms (~2.2 req/s);
# values below 450 are clamped, so this can only make it slower.
PROSPEO_MIN_INTERVAL_MS=

# ============================================================
# OPTIONAL — list-builder (contacts, email finding, cross-run dedup)
# ============================================================
# Every var in this block is optional: list-builder logs a skip line and keeps
# going without it. Only PROSPEO_API_KEY + OPENAI_API_KEY are required.

# GetLeads (free contact counts + exports, first stop in the contacts waterfall).
# Sign up: https://getleads.io/  — unset ⇒ every domain falls to Blitz/Prospeo.
GETLEADS_API_KEY=

# Cross-run dedup registry: a Postgres connection string for the
# list_builder_judged_domains table (DDL: skills/list-builder/references/registry-schema.sql).
# Unset ⇒ per-run WAL dedup only. `psql` must be on PATH when set.
LIST_REGISTRY_DB_URL=

# Google Sheets destination for a lane (skills/list-builder/scripts/push-sheet.py):
# path to a service-account JSON with the target sheet shared to its email.
# Unset ⇒ omit destination.sheet_id in lane.json and the lane is CSV-only.
GOOGLE_APPLICATION_CREDENTIALS=

# OPTIONAL: directory where list-builder / list-expander scripts drop run metrics JSON.
RUN_METRICS_DIR=

# ============================================================
# OPTIONAL — alternative sending platform
# ============================================================

# Instantly (alternative to Smartlead). Sign up: https://instantly.ai/
INSTANTLY_API_KEY=

# ============================================================
# OPTIONAL — personalization + enrichment
# ============================================================

# OpenRouter (cheap AI for first-line personalization). Sign up: https://openrouter.ai/
# If using auto-research-public, you do NOT need this — Claude Code does the reasoning.
# Only needed for the cold-email-starter-kit "enrichment" scripts that use OpenRouter.
OPENROUTER_API_KEY=

# OpenWebNinja (company news + blog enrichment). Sign up: https://www.openwebninja.com/
OPENWEBNINJA_KEY=

# ============================================================
# SENDER IDENTITY (used in inbox signatures + from-names)
# ============================================================
# Applied by smartlead-inbox-manager's set-signatures.ts in bulk.
# Default signature template: {from_name} / {title} / {company} / {address}

SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=            # e.g. "Founder", "CEO", "VP of Revenue"
SENDER_COMPANY_NAME=
SENDER_WEBSITE=
SENDER_PHYSICAL_ADDRESS= # Recommended — full mailing address, one line. Goes in the email footer.

# ============================================================
# SIGNAL PLAYBOOKS (Track 6) — only what the playbooks you run need
# ============================================================
# OPENAI_API_KEY above covers every playbook with a locked prompt.

# Clay CLI, for the clay-workflow.md builds. `clay login` (browser OAuth) also works.
CLAY_API_KEY=

# Apify — ad-library, linkedin-engagement, social-posts. https://apify.com/
APIFY_API_TOKEN=

# A JS-rendering proxy, for pages that return a bot wall or an empty JS shell
# (pricing-page, case-study-page, tech-on-website, social-link-finding).
ZENROWS_API_KEY=
